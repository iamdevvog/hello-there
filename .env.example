# MediKiosk environment variables
# Copy to `.env` for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# Only VITE_CLERK_PUBLISHABLE_KEY is public; every other value is server-only.
# Lovable's secret store is NOT copied to Vercel; add your keys there separately.

# Public Clerk key, injected at build time. Must match CLERK_SECRET_KEY's instance.
VITE_CLERK_PUBLISHABLE_KEY=
# Paste your matching public key; use the production instance for public launch.

# ---------------------------------------------------------------------------
# Database — Turso (libSQL). Required. Tables are created automatically on
# first request; no manual migration step is needed.
# Get from: https://turso.tech → your database → "Connect" / "Create token"
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Authentication — Clerk. Required for staff/clinician/patient sign-in.
# Get from: https://dashboard.clerk.com → API Keys
# The publishable key is supplied above; no source changes are needed.
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=
# This project's secure store currently uses STRIPE_TEST_API_KEY for the Clerk
# credential. Request middleware accepts that legacy name as a server-only
# fallback; new deployments should set CLERK_SECRET_KEY as shown above.

# ---------------------------------------------------------------------------
# Clinical AI — Google Gemini. Required for adaptive intake questions,
# fact extraction and AI visit summaries.
# Get from: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional override: choose a generateContent/structured-output capable model
# available to your own Google account. Default is Google's Flash alias.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Document OCR — OCR.space. Required for prescription/report scanning.
# Get from: https://ocr.space/ocrapi (quota and API access required)
# ---------------------------------------------------------------------------
OCR_SPACE_API_KEY=

# ---------------------------------------------------------------------------
# Voice output — ElevenLabs text-to-speech. Required for spoken kiosk prompts.
# Get from: https://elevenlabs.io → Profile → API Keys, and pick a voice ID
# from the Voice Library.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# Patient assistant chat + speech-to-text via Groq (Whisper + GPT-OSS).
# Required for the patient health portal helper and voice transcription at kiosk.
# Get from: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Medication Safety gates; leave approval false until operator privacy review.
# Patient consent is separately required inside each case.
MEDICATION_EXTERNAL_PROCESSING_APPROVED=false
# Map REAL provisioned Clerk user IDs to clinician/pharmacist. No automatic roles.
MEDICATION_PROFESSIONAL_ROLES='{}'
# Optional licensed catalogue / clinically reviewed rules. Empty = unavailable.
MEDICATION_CATALOGUE_JSON='[]'
MEDICATION_RULES_JSON='[]'

# JSON quotes above are for local .env syntax. In Vercel enter raw JSON without
# surrounding shell quotes. Never place real patient data in these settings.
# No LOVABLE_API_KEY or Lovable AI credit configuration is required.
